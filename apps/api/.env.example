# Database
DATABASE_URL="postgresql://faineant:faineant_dev@localhost:5432/faineant_dev?schema=public"

# Auth (min 16 chars each)
JWT_SECRET="change-me-in-production-min16"
JWT_REFRESH_SECRET="change-me-in-production-refresh-min16"

# Stripe Connect
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PLATFORM_FEE_PERCENT="5"

# Google Calendar Sync (OAuth 2.0 — create at console.cloud.google.com)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3001/api/v1/calendar/google/callback"

# Google Maps
GOOGLE_MAPS_API_KEY=""

# File Storage (S3 — legacy, optional)
S3_BUCKET="faineant-uploads"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Object Storage — Cloudflare R2 (S3-compatible). Used by /uploads.
# Account ID is the Cloudflare account ID (R2 dashboard URL).
# Public URL should be the bucket's r2.dev URL or your custom domain.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="faineant-uploads"
R2_PUBLIC_URL="https://uploads.faineant.co"

# SMS (Twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Email transport (Resend) — leave RESEND_API_KEY empty in dev to no-op.
RESEND_API_KEY=""
EMAIL_FROM_NAME="Faineant"
EMAIL_FROM_ADDRESS="noreply@faineant.co"

# AI (optional)
ANTHROPIC_API_KEY=""

# Server
API_PORT="3001"
WEB_URL="http://localhost:3000"
NODE_ENV="development"
