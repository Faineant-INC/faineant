{
  "name": "faineant",
  "version": "0.1.0",
  "private": true,
  "description": "FAINEANT - In-home beauty services in Chicago",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @faineant/web test:e2e",
    "test:e2e:ui": "pnpm --filter @faineant/web test:e2e:ui",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:migrate:deploy": "supabase db push --linked",
    "db:types": "supabase gen types typescript --local > packages/shared/src/database.types.ts",
    "qa:provision": "pnpm --filter @faineant/web qa:provision",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.0",
    "supabase": "2.111.0",
    "turbo": "^2.9.14",
    "typescript": "^5.4.0"
  },
  "packageManager": "pnpm@9.1.0",
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom": "0.8.13",
      "next@15.5.21>postcss": "8.5.25",
      "next@15.5.21>sharp": "0.35.3",
      "@babel/core@<=7.29.0": "7.29.6",
      "brace-expansion@<2": "1.1.17",
      "brace-expansion@>=2 <3": "2.1.3",
      "brace-expansion@>=5 <5.0.8": "5.0.8",
      "esbuild@>=0.21 <0.25": "0.25.12",
      "esbuild@>=0.27.3 <0.28.1": "0.28.1",
      "fast-xml-parser": "5.7.3",
      "form-data@>=4 <4.0.6": "4.0.6",
      "joi@<17.13.4": "17.13.4",
      "js-yaml@<4": "3.15.0",
      "js-yaml@>=4 <5": "4.3.0",
      "postcss": "8.5.25",
      "shell-quote@<1.9.0": "1.9.0",
      "uuid@<11.1.1": "11.1.1",
      "vite@<6.4.3": "6.4.3",
      "ws@>=6 <7": "6.2.4",
      "ws@>=7 <8": "7.5.11",
      "ws@>=8 <9": "8.21.0"
    }
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
